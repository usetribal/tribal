{
  "$defs": {
    "AgentKind": {
      "enum": [
        "cursor",
        "claude",
        "codex"
      ],
      "type": "string"
    },
    "Artifact": {
      "properties": {
        "blob_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "description": "Content-addressed sha256 hex for binary media (images, diagrams).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "line_range": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "preview_data_url": {
          "description": "Populated on read/export for UI preview; not persisted to git refs.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolve": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactResolve"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "file_edit",
        "terminal_command",
        "diff",
        "image",
        "diagram",
        "screenshot"
      ],
      "type": "string"
    },
    "ArtifactResolve": {
      "properties": {
        "old_string": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy": {
          "$ref": "#/$defs/ResolveStrategy"
        }
      },
      "required": [
        "strategy"
      ],
      "type": "object"
    },
    "ResolveStrategy": {
      "enum": [
        "old_string",
        "full_file",
        "diff_hunk",
        "citation"
      ],
      "type": "string"
    },
    "Role": {
      "enum": [
        "user",
        "assistant",
        "system",
        "tool"
      ],
      "type": "string"
    },
    "ToolCall": {
      "properties": {
        "arguments": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "Turn": {
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "type": "array"
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "timestamp": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "role",
        "content"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentKind"
    },
    "commit_shas": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ended_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "parent_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "private": {
      "default": false,
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "type": "array"
    },
    "workspace_root": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "agent",
    "started_at",
    "workspace_root",
    "turns"
  ],
  "title": "Conversation",
  "type": "object"
}
