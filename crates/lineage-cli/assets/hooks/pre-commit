#!/bin/sh
# Lineage pre-commit hook: import agent sessions before each commit.
set -e

export PATH="${HOME}/.cargo/bin:${PATH}"

if command -v tribal >/dev/null 2>&1; then
  if ! tribal import --agent all --no-link-head --incremental; then
    echo "tribal: import failed (commit continues)" >&2
  fi
else
  echo "tribal: not on PATH, skipping import (commit continues)" >&2
fi
