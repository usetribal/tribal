{
  "name": "lineage-vscode",
  "displayName": "Lineage",
  "description": "Git-native AI agent provenance in VS Code",
  "version": "0.6.0",
  "publisher": "usetribal",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lineage.import",
        "title": "Lineage: Import Sessions",
        "icon": "$(cloud-download)"
      },
      {
        "command": "lineage.refresh",
        "title": "Lineage: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "lineage.openSession",
        "title": "Lineage: View Conversation",
        "icon": "$(open-preview)"
      },
      {
        "command": "lineage.resumeSession",
        "title": "Lineage: Resume Conversation",
        "icon": "$(run)"
      },
      {
        "command": "lineage.forkSession",
        "title": "Lineage: Fork Conversation",
        "icon": "$(git-branch)"
      },
      {
        "command": "lineage.showLineage",
        "title": "Lineage: Show Lineage for Line",
        "icon": "$(git-commit)"
      },
      {
        "command": "lineage.installHook",
        "title": "Lineage: Install Git Hooks"
      },
      {
        "command": "lineage.search",
        "title": "Lineage: Search Sessions"
      },
      {
        "command": "lineage.doctor",
        "title": "Lineage: Doctor"
      },
      {
        "command": "lineage.viewCommit",
        "title": "Lineage: View Commit"
      },
      {
        "command": "lineage.materialize",
        "title": "Lineage: Materialize Line Objects"
      },
      {
        "command": "lineage.remap",
        "title": "Lineage: Remap After Rebase"
      },
      {
        "command": "lineage.initConfig",
        "title": "Lineage: Init Config"
      },
      {
        "command": "lineage.deleteSession",
        "title": "Lineage: Delete Session",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "lineage": [
        {
          "id": "lineageSessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lineage",
          "title": "Lineage",
          "icon": "$(git-commit)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lineage.refresh",
          "when": "view == lineageSessions",
          "group": "navigation"
        },
        {
          "command": "lineage.import",
          "when": "view == lineageSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lineage.openSession",
          "when": "view == lineageSessions",
          "group": "inline"
        },
        {
          "command": "lineage.deleteSession",
          "when": "view == lineageSessions && viewItem == lineageSession",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "lineage.showLineage",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Lineage",
      "properties": {
        "lineage.decorateGutter": {
          "type": "boolean",
          "default": true,
          "description": "Show lineage indicators in the editor gutter"
        },
        "lineage.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh session list after import"
        },
        "lineage.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to tribal binary (empty = use tribal on PATH)"
        },
        "lineage.hoverEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show lineage blame on editor hover"
        }
      }
    },
    "keybindings": [
      {
        "command": "lineage.showLineage",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --max-warnings 0",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "npm run compile && npm run lint && npm run format:check",
    "package": "npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.0",
    "typescript": "^5.3.0"
  }
}
